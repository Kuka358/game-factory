{
  "name": "@game-factory/engine-phaser",
  "version": "0.1.0",
  "private": true,
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },

    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js",
      "default": "./dist/backend/index.js"
    }
  },

  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@game-factory/game-spec": "workspace:*",
    "@game-factory/runtime": "workspace:*",
    "@game-factory/engine-core": "workspace:*",
    "@game-factory/templates": "workspace:*",
    "@game-factory/assets": "workspace:*",
    "@game-factory/platform-core": "workspace:*",
    "@game-factory/platform-web": "workspace:*",
    "@game-factory/platform-yandex": "workspace:*",
    "phaser": "^3.90.0",
    "vite": "^7.3.6"
  }
}