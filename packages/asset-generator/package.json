{
  "name": "@game-factory/asset-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark:quality": "pnpm build && node scripts/benchmark-models.mjs",
    "benchmark:detail": "pnpm build && node scripts/benchmark-detail.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@game-factory/assets": "workspace:*",
    "sharp": "^0.35.4"
  }
}